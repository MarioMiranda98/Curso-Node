{
  "name": "07-rest-web",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec node --loader ts-node/esm src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "prisma:generate:prod": "npx prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:test": "dotenv -e .env.sample -- npx prisma migrate deploy",
    "test": "npm run prisma:migrate:test && jest --coverage",
    "test:watch": "npm run prisma:migrate:test && jest --watchAll --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.1",
    "env-var": "^7.5.0",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "prisma": "^6.15.0"
  }
}
